# ── Base de données ──
POSTGRES_USER=pixel
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long
POSTGRES_DB=pixel_finance

# Requis pour `npm run dev` et `npm run db:migrate`.
# Docker Compose fournit sa propre DATABASE_URL au conteneur app.
DATABASE_URL=postgres://127.0.0.1:5432/pixel_finance

# ── Sécurité ── (générer avec : openssl rand -base64 48)
AUTH_SECRET=changez-moi-avec-une-chaine-aleatoire-de-48-caracteres

# true derrière HTTPS (reverse proxy), false si vous testez en http://IP:3000
COOKIE_SECURE=true
# Durée de vie absolue de session (secondes), ex: 43200 = 12h
SESSION_MAX_AGE_SECONDS=43200
# Déconnexion automatique après inactivité (secondes), ex: 1800 = 30min
SESSION_IDLE_SECONDS=1800

# ── Premier administrateur (créé uniquement si aucun utilisateur n'existe) ──
ADMIN_EMAIL=admin@pixel-nomade.com
ADMIN_PASSWORD=changez-moi-8-caracteres-min
ADMIN_NAME=Mohamed

# Port exposé sur le VPS (127.0.0.1 uniquement, à servir via Nginx/Caddy)
APP_PORT=3000
